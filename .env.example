# Variáveis do servidor do portal (GGVP-158). Só os nomes: os valores ficam no Coolify ou no .env de cada máquina,
# nunca no repositório, no Jira ou no chat. O que cada uma faz está em docs/infra/homologacao.md ("Variáveis do servidor").
# Descomente e preencha só o que for usar: variável vazia não é o mesmo que ausente (PORTA vazia sobe em porta aleatória).
# O teste apps/api/src/variaveis.test.ts confere que toda variável que o servidor lê está aqui.

# Banco e execução
# DATABASE_URL=
# BANCO_LOCAL=
# NODE_ENV=
# PORTA=
# HOST=
# VERSAO=
# AMBIENTE=

# Cofre do gov.br
# COFRE_CHAVE=

# Arquivos (Supabase Storage)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# IA
# OPENAI_API_KEY=
# OPENAI_MODELO=
# OPENAI_MODELO_AO_VIVO=
# OPENAI_MODELO_TRANSCRICAO=
# OPENAI_MODELO_VETOR=
# MISTRAL_API_KEY=
# MISTRAL_MODELO_OCR=
# IA_PERMITE_DADO_DE_SAUDE=

# Drive do escritório
# GOOGLE_DRIVE_CREDENCIAIS=
# GOOGLE_DRIVE_PASTA_CLIENTES=
# GOOGLE_DRIVE_PASTA_REVISAR=
# GOOGLE_DRIVE_SO_LEITURA=

# Chatwoot (mensagens ao cliente)
# CHATWOOT_URL=
# CHATWOOT_CONTA=
# CHATWOOT_CAIXA=
# CHATWOOT_TOKEN=
# CHATWOOT_PERMITIDOS=
# RELACIONAMENTO_SIMULADO=

# Kit do contrato
# GOTENBERG_URL=
# ZAPSIGN_API_TOKEN=

# Vigília do diário
# FONTES_PUBLICACAO=
# DJEN_OABS=
# AASP_CHAVES=
# VIGILIA_TRIBUNAIS=

# Comando modelos:subir (na máquina de quem sobe os modelos, não no servidor)
# PORTAL_URL=
# SENIOR_EMAIL=
# SENIOR_SENHA=
